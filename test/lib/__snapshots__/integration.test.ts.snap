// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Nightmare Contract Stress Test > should snapshot nightmare contract output 1`] = `
"import { type Schema, b } from "@zorsh/zorsh";


export const TokenAmountSchema = b.struct({
  amount: b.u128(),
  decimals: b.u8()
});
export type TokenAmount = b.infer<typeof TokenAmountSchema>;

export const AssetIdSchema = b.enum({
  Native: b.unit(),
  FungibleToken: b.string(),
  NonFungibleToken: b.struct({
    contract_id: b.string(),
    token_id: b.string()
  }),
  MultiToken: b.struct({
    contract_id: b.string(),
    token_id: b.string(),
    amount: TokenAmountSchema
  })
});
export type AssetId = b.infer<typeof AssetIdSchema>;

export const AttributeSchema = b.struct({
  trait_type: b.string(),
  value: b.string(),
  display_type: b.option(b.string()),
  max_value: b.option(b.u64())
});
export type Attribute = b.infer<typeof AttributeSchema>;

export const VoteWeightSchema = b.enum({
  Equal: b.unit(),
  TokenWeighted: b.u128(),
  QuadraticTokenWeighted: b.u128(),
  DelegatedFrom: b.vec(b.tuple(b.string(), b.u128()))
});
export type VoteWeight = b.infer<typeof VoteWeightSchema>;

export const VoteSchema = b.struct({
  voter: b.string(),
  weight: VoteWeightSchema,
  approve: b.bool(),
  timestamp: b.u64(),
  memo: b.option(b.string())
});
export type Vote = b.infer<typeof VoteSchema>;

export const AuditActionSchema: Schema<unknown> = b.enum({
  Transfer: b.struct({
    from: b.string(),
    to: b.string(),
    asset: AssetIdSchema,
    amount: TokenAmountSchema
  }),
  Swap: b.struct({
    pool_id: b.u64(),
    amount_in: TokenAmountSchema,
    amount_out: TokenAmountSchema
  }),
  Stake: b.struct({
    amount: b.u128(),
    tier: b.string()
  }),
  Unstake: b.struct({
    amount: b.u128(),
    tier: b.string()
  }),
  ProposalCreated: b.u64(),
  ProposalVoted: b.struct({
    proposal_id: b.u64(),
    vote: VoteSchema
  }),
  ConfigChanged: b.struct({
    key: b.string(),
    old_value: b.option(b.vec(b.u8())),
    new_value: b.vec(b.u8())
  }),
  NftMinted: b.struct({
    token_id: b.string(),
    owner: b.string()
  }),
  NftTransferred: b.struct({
    token_id: b.string(),
    from: b.string(),
    to: b.string()
  }),
  BatchAction: b.vec(b.lazy(() => AuditActionSchema))
});
export type AuditAction = b.infer<typeof AuditActionSchema>;

export const PriceOracleSchema = b.struct({
  source: b.string(),
  price: b.u128(),
  decimals: b.u8(),
  timestamp: b.u64(),
  confidence: b.option(b.f64())
});
export type PriceOracle = b.infer<typeof PriceOracleSchema>;

export const LiquidityPoolSchema = b.struct({
  pool_id: b.u64(),
  token_a: AssetIdSchema,
  token_b: AssetIdSchema,
  reserve_a: TokenAmountSchema,
  reserve_b: TokenAmountSchema,
  total_shares: b.u128(),
  fee_rate: b.u32(),
  oracle: b.option(PriceOracleSchema),
  user_shares: b.hashMap(b.string(), b.u128())
});
export type LiquidityPool = b.infer<typeof LiquidityPoolSchema>;

export const ProposalConditionSchema: Schema<unknown> = b.enum({
  TimePassed: b.u64(),
  QuorumReached: b.struct({
    threshold: b.u128()
  }),
  OraclePrice: b.struct({
    oracle: PriceOracleSchema,
    above: b.option(b.u128()),
    below: b.option(b.u128())
  }),
  And: b.vec(b.lazy(() => ProposalConditionSchema)),
  Or: b.vec(b.lazy(() => ProposalConditionSchema)),
  Not: b.lazy(() => ProposalConditionSchema)
});
export type ProposalCondition = b.infer<typeof ProposalConditionSchema>;

export const ProposalActionSchema: Schema<unknown> = b.enum({
  Transfer: b.struct({
    recipient: b.string(),
    asset: AssetIdSchema,
    amount: TokenAmountSchema,
    memo: b.option(b.string())
  }),
  AddLiquidity: b.struct({
    pool: LiquidityPoolSchema,
    amounts: b.tuple(TokenAmountSchema, TokenAmountSchema)
  }),
  RemoveLiquidity: b.struct({
    pool_id: b.u64(),
    shares: b.u128(),
    min_amounts: b.tuple(TokenAmountSchema, TokenAmountSchema)
  }),
  UpdateConfig: b.hashMap(b.string(), b.string()),
  UpgradeContract: b.struct({
    code_hash: b.array(b.u8(), 32),
    migration_args: b.option(b.vec(b.u8()))
  }),
  BatchActions: b.vec(b.lazy(() => ProposalActionSchema)),
  ConditionalAction: b.struct({
    condition: b.lazy(() => ProposalConditionSchema),
    if_true: b.lazy(() => ProposalActionSchema),
    if_false: b.option(b.lazy(() => ProposalActionSchema))
  })
});
export type ProposalAction = b.infer<typeof ProposalActionSchema>;

export const ProposalStatusSchema = b.enum({
  Draft: b.unit(),
  Active: b.struct({
    start_time: b.u64(),
    end_time: b.u64()
  }),
  Approved: b.struct({
    approved_at: b.u64(),
    execution_deadline: b.u64()
  }),
  Rejected: b.struct({
    rejected_at: b.u64(),
    reason: b.option(b.string())
  }),
  Executed: b.struct({
    executed_at: b.u64(),
    result: b.vec(b.u8())
  }),
  Expired: b.unit()
});
export type ProposalStatus = b.infer<typeof ProposalStatusSchema>;

export const ProposalSchema = b.struct({
  id: b.u64(),
  proposer: b.string(),
  title: b.string(),
  description: b.string(),
  actions: b.vec(ProposalActionSchema),
  status: ProposalStatusSchema,
  votes: b.vec(VoteSchema),
  vote_counts: b.hashMap(b.bool(), b.u128()),
  created_at: b.u64(),
  metadata: b.hashMap(b.string(), b.string())
});
export type Proposal = b.infer<typeof ProposalSchema>;

export const TokenMetadataSchema = b.struct({
  title: b.option(b.string()),
  description: b.option(b.string()),
  media: b.option(b.string()),
  media_hash: b.option(b.array(b.u8(), 32)),
  copies: b.option(b.u64()),
  issued_at: b.option(b.u64()),
  expires_at: b.option(b.u64()),
  starts_at: b.option(b.u64()),
  updated_at: b.option(b.u64()),
  extra: b.option(b.string()),
  reference: b.option(b.string()),
  reference_hash: b.option(b.array(b.u8(), 32)),
  attributes: b.vec(AttributeSchema)
});
export type TokenMetadata = b.infer<typeof TokenMetadataSchema>;

export const RoyaltySchema = b.struct({
  accounts: b.hashMap(b.string(), b.u32()),
  max_payout: b.option(b.u128())
});
export type Royalty = b.infer<typeof RoyaltySchema>;

export const TokenOfferSchema = b.struct({
  offerer: b.string(),
  amount: TokenAmountSchema,
  asset: AssetIdSchema,
  expires_at: b.option(b.u64()),
  conditions: b.vec(ProposalConditionSchema)
});
export type TokenOffer = b.infer<typeof TokenOfferSchema>;

export const NftTokenSchema = b.struct({
  token_id: b.string(),
  owner_id: b.string(),
  metadata: TokenMetadataSchema,
  royalty: b.option(RoyaltySchema),
  approved_account_ids: b.hashMap(b.string(), b.u64()),
  split_owners: b.option(b.hashMap(b.string(), b.u32())),
  transfer_history: b.vec(b.tuple(b.u64(), b.string(), b.string(), b.option(b.string()))),
  offers: b.vec(TokenOfferSchema)
});
export type NftToken = b.infer<typeof NftTokenSchema>;

export const StakingRewardSchema = b.struct({
  asset: AssetIdSchema,
  amount_per_day: TokenAmountSchema,
  vesting_schedule: b.option(b.vec(b.tuple(b.u64(), b.u32()))),
  multiplier_by_tier: b.hashMap(b.string(), b.f64())
});
export type StakingReward = b.infer<typeof StakingRewardSchema>;

export const StakingTierSchema = b.struct({
  name: b.string(),
  min_stake: b.u128(),
  max_stake: b.option(b.u128()),
  apy_basis_points: b.u32(),
  lockup_period: b.u64(),
  rewards: b.vec(StakingRewardSchema),
  eligible_pools: b.option(b.vec(b.u64())),
  bonus_conditions: b.vec(ProposalConditionSchema)
});
export type StakingTier = b.infer<typeof StakingTierSchema>;

export const ContractStateSchema = b.struct({
  owner_id: b.string(),
  version: b.tuple(b.u8(), b.u8(), b.u8()),
  pools: b.vec(LiquidityPoolSchema),
  pool_index: b.hashMap(b.tuple(b.string(), b.string()), b.u64()),
  user_positions: b.hashMap(b.string(), b.vec(b.tuple(b.u64(), b.u128()))),
  proposals: b.vec(ProposalSchema),
  active_proposal_ids: b.hashSet(b.u64()),
  council_members: b.hashSet(b.string()),
  delegation_map: b.hashMap(b.string(), b.vec(b.tuple(b.string(), b.u128()))),
  tokens: b.hashMap(b.string(), NftTokenSchema),
  tokens_per_owner: b.hashMap(b.string(), b.hashSet(b.string())),
  collection_metadata: TokenMetadataSchema,
  staking_tiers: b.vec(StakingTierSchema),
  config: b.hashMap(b.string(), b.vec(b.u8())),
  paused_features: b.hashSet(b.string()),
  audit_log: b.vec(b.tuple(b.u64(), b.string(), AuditActionSchema, b.option(b.hashMap(b.string(), b.string()))))
});
export type ContractState = b.infer<typeof ContractStateSchema>;"
`;

exports[`ZorshGenerator Integration > should snapshot the full output 1`] = `
"import { b } from "@zorsh/zorsh";


export const AchievementSchema = b.struct({
  id: b.string(),
  name: b.string(),
  description: b.string(),
  reward_points: b.u32(),
  completed_at: b.option(b.u64()),
  prerequisites: b.vec(b.string())
});
export type Achievement = b.infer<typeof AchievementSchema>;

export const StatsSchema = b.struct({
  strength: b.u16(),
  dexterity: b.u16(),
  intelligence: b.u16(),
  health: b.u32(),
  mana: b.u32()
});
export type Stats = b.infer<typeof StatsSchema>;

export const CharacterClassSchema = b.enum({
  Warrior: StatsSchema,
  Mage: b.struct({
    base_stats: StatsSchema,
    spells_known: b.vec(b.string()),
    mana_regen: b.f32()
  }),
  Rogue: b.struct({
    base_stats: StatsSchema,
    stealth_level: b.u8(),
    critical_chance: b.f32()
  })
});
export type CharacterClass = b.infer<typeof CharacterClassSchema>;

export const GuildMembershipSchema = b.struct({
  guild_id: b.string(),
  guild_name: b.string(),
  joined_at: b.u64(),
  rank: b.string(),
  permissions: b.hashSet(b.string())
});
export type GuildMembership = b.infer<typeof GuildMembershipSchema>;

export const ItemRaritySchema = b.enum({
  Common: b.unit(),
  Uncommon: b.unit(),
  Rare: b.unit(),
  Epic: b.unit(),
  Legendary: b.unit()
});
export type ItemRarity = b.infer<typeof ItemRaritySchema>;

export const ItemEffectSchema = b.enum({
  Damage: b.u32(),
  Heal: b.struct({
    amount: b.u32(),
    duration: b.u16()
  }),
  Status: b.struct({
    effect_type: b.string(),
    power: b.u16(),
    duration: b.u32()
  }),
  None: b.unit()
});
export type ItemEffect = b.infer<typeof ItemEffectSchema>;

export const ItemSchema = b.struct({
  id: b.string(),
  name: b.string(),
  description: b.string(),
  rarity: ItemRaritySchema,
  level_requirement: b.u8(),
  effects: b.vec(ItemEffectSchema),
  stats: b.option(StatsSchema),
  metadata: b.hashMap(b.string(), b.string())
});
export type Item = b.infer<typeof ItemSchema>;

export const LocationSchema = b.struct({
  lat: b.f64(),
  lng: b.f64(),
  altitude: b.option(b.u32())
});
export type Location = b.infer<typeof LocationSchema>;

export const QuestProgressSchema = b.struct({
  quest_id: b.string(),
  started_at: b.u64(),
  steps_completed: b.vec(b.u32()),
  current_step: b.u32(),
  collected_items: b.hashMap(b.string(), b.u32())
});
export type QuestProgress = b.infer<typeof QuestProgressSchema>;

export const TradeSchema = b.struct({
  id: b.string(),
  from_player: b.string(),
  to_player: b.string(),
  items: b.vec(ItemSchema),
  gold_amount: b.u64(),
  status: b.string(),
  created_at: b.u64(),
  completed_at: b.option(b.u64())
});
export type Trade = b.infer<typeof TradeSchema>;

export const PlayerCharacterSchema = b.struct({
  id: b.string(),
  name: b.string(),
  created_at: b.u64(),
  last_login: b.u64(),
  character_class: CharacterClassSchema,
  level: b.u32(),
  experience: b.u64(),
  location: LocationSchema,
  inventory: b.vec(ItemSchema),
  equipped_items: b.hashMap(b.string(), ItemSchema),
  achievements: b.vec(AchievementSchema),
  completed_quests: b.hashSet(b.string()),
  active_quests: b.vec(QuestProgressSchema),
  guild: b.option(GuildMembershipSchema),
  current_trades: b.vec(TradeSchema),
  friends: b.hashSet(b.string()),
  blocked_players: b.hashSet(b.string()),
  settings: b.hashMap(b.string(), b.string()),
  last_deaths: b.vec(b.tuple(b.u64(), LocationSchema, b.string())),
  skill_levels: b.hashMap(b.string(), b.tuple(b.u16(), b.f32()))
});
export type PlayerCharacter = b.infer<typeof PlayerCharacterSchema>;"
`;
